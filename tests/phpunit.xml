<?xml version="1.0" encoding="UTF-8"?>
<!--
    Run from the plugin root with Stud.IP's PHPUnit:
    /path/to/studip/composer/bin/phpunit -c tests/phpunit.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="unit">
            <directory>.</directory>
        </testsuite>
    </testsuites>
</phpunit>
